{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "dashboard_data/**,app/static/**"
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "dashboard_data/**",
          "app/static/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
